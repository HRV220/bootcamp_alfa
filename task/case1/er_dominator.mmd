erDiagram
    MATCHES ||--o{ MATCH_PLAYERS : "match_id"
    MATCHES ||..o{ PURCHASE_EVENTS : "match_id"
    ITEMS ||..o{ PURCHASE_EVENTS : "item_id = itemid"
    MATCH_PLAYERS ||..o{ PURCHASE_EVENTS : "match_id + account_id"
    HEROES ||..o{ MATCH_PLAYERS : "hero_id (pending)"

    MATCHES {
        bigint match_id PK
        int duration
        int game_mode
        int lobby_type
        boolean radiant_win
    }
    MATCH_PLAYERS {
        bigint match_id PK,FK
        int player_slot PK
        bigint account_id
        int hero_id FK
        int rank
        boolean is_radiant
        boolean win
    }
    ITEMS {
        int item_id PK
        string name
    }
    PURCHASE_EVENTS {
        bigint match_id FK
        bigint steam_account_id
        int itemid FK
        int time
    }
    HEROES {
        int hero_id PK
        string localized_name
    }
